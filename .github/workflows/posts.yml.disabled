name: Telegram Posts

on:
  schedule:
    - cron: "10 5 * * 1,3,5"
  workflow_dispatch:

jobs:
  post:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Send post (no duplicates)
        env:
          TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          CHANNEL_TOKEN: ${{ secrets.TELEGRAM_CHANNEL_TOKEN }}
          CHAT_ID: "@webstudio_chanel"
          GH_TOKEN: ${{ secrets.GH_PAT }}
        run: |
          python3 << 'PYEOF'
          import json, os, datetime, urllib.request, urllib.error

          with open('.github/scripts/posts.json') as f:
              posts = json.load(f)

          # state: последний отправленный idx (антидубль)
          state_path = '.github/scripts/posts_state.json'
          state = {"last_sent_idx": -1, "last_sent_date": ""}
          try:
              with open(state_path) as f:
                  state = json.load(f)
          except FileNotFoundError:
              pass

          day = datetime.datetime.now().weekday()
          day_offset = {0:0, 2:1, 4:2}.get(day, 0)
          week = datetime.datetime.now().isocalendar()[1]
          total = len(posts)
          idx = (week * 3 + day_offset) % total

          if idx == state.get("last_sent_idx"):
              print(f"SKIP: пост {idx} уже отправлен {state.get('last_sent_date')} — дубль не отправляем")
              raise SystemExit(0)

          post = posts[idx]
          text = post[2] if isinstance(post, list) else post
          chat_id = os.environ['CHAT_ID']

          candidates = [
              ('TELEGRAM_TOKEN', os.environ.get('TOKEN', '')),
              ('TELEGRAM_CHANNEL_TOKEN', os.environ.get('CHANNEL_TOKEN', '')),
          ]

          last_err = None
          for name, token in candidates:
              if not token:
                  continue
              req = urllib.request.Request(
                  f'https://api.telegram.org/bot{token}/sendMessage',
                  data=json.dumps({'chat_id': chat_id, 'parse_mode': 'HTML', 'text': text}).encode(),
                  headers={'Content-Type': 'application/json'}
              )
              try:
                  resp = urllib.request.urlopen(req)
                  print(f'Sent post {idx} via {name}: {post[1]}')
                  print(f'Response: {resp.read().decode()}')
                  last_err = None
                  # сохранить state
                  state["last_sent_idx"] = idx
                  state["last_sent_date"] = datetime.datetime.now().isoformat()
                  with open(state_path, 'w') as f:
                      json.dump(state, f, indent=2)
                  break
              except urllib.error.HTTPError as e:
                  last_err = e
                  print(f'{name} failed: HTTP {e.code}: {e.read().decode()}')

          if last_err is not None:
              raise last_err
          PYEOF

      - name: Commit state (anti-duplicate)
        env:
          GH_TOKEN: ${{ secrets.GH_PAT }}
        run: |
          git remote set-url origin "https://x-access-token:${GH_TOKEN}@github.com/uriy-as/site.git"
          git config --unset-all http.https://github.com/.extraheader || true
          git config user.name "Telegram Posts"
          git config user.email "posts@uriy-as.org"
          git add .github/scripts/posts_state.json
          if git diff --quiet --staged; then
            echo "no state changes"
          else
            git commit -m "posts: state update $(date -u +%F)"
            git fetch origin main && git rebase origin/main
            git push
          fi